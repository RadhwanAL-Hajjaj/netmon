# Copy to keystore.properties (git ignores it) and fill in your own values.
# storeFile is relative to this folder. To make a new keystore:
#   keytool -genkeypair -keystore netmon-release.jks -storetype PKCS12 \
#       -alias netmon -keyalg RSA -keysize 2048 -validity 10950
storeFile=netmon-release.jks
storePassword=your-keystore-password
keyAlias=netmon
keyPassword=your-key-password
